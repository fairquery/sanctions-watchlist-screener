    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "apify": "^3.7.0",
        "csv-parse": "^6.1.0",
        "fast-xml-parser": "^5.2.0"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^5.8.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^3.0.0"
    },
    "scripts": {
        "start": "npm run start:dev",
